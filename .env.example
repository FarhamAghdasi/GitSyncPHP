# ==========================================
# GitHub Repository Configuration
# ==========================================
GITHUB_TOKEN=ghp_your_actual_github_token_here
REPO_USER=farhamaghdasi
REPO_NAME=your-repository-name
BRANCH=main

# ==========================================
# Telegram Notifications (Optional)
# ==========================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ==========================================
# Backup Settings
# ==========================================
BACKUP_BEFORE_UPDATE=true
BACKUP_DIR=__backups
DELETE_EXTRACTED_FILES=true

# ==========================================
# Files & Paths
# ==========================================
LOG_FILE=update_log.txt
VERSION_FILE=.version
EXCLUDE_FILES=git,.env,.update_key,.ip_whitelist,__backups,*.log,update_log.txt

# ==========================================
# Proxy Settings (NEW)
# ==========================================
# Enable Cloudflare Worker proxy for GitHub API and Telegram
USE_PROXY=true

# Your Cloudflare Worker URL
PROXY_URL=https://github-proxy.your-subdomain.workers.dev